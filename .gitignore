# ---- Secrets (never commit) -------------------------------------------------
.env
.env.*
!.env.example
# ...but the ENCRYPTED copy is committed on purpose (Day 9):
!secrets/.env.enc
*.key
*.pem
secrets/*.key
secrets/.env
# Encrypted snapshots stay on this machine (copy them to a USB drive yourself).
/backups/

# ---- DVC-managed outputs (tracked through dvc.lock / .dvc files instead) ----
/data/*
!/data/.gitkeep
/models/*
!/models/.gitkeep

# reports/ holds DVC metrics JSON that IS committed (small, human-readable);
# only bulky or transient report files are ignored.
/reports/*.html
/reports/tmp/

# ---- MLflow local stores ----------------------------------------------------
mlruns/
mlartifacts/
mlflow.db
mlflow.db-journal

# ---- Logs -------------------------------------------------------------------
/logs/*
!/logs/.gitkeep
*.log

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
.ipynb_checkpoints/
.python-version

# ---- Spark ------------------------------------------------------------------
spark-warehouse/
metastore_db/
derby.log

# ---- OS / editors -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
desktop.ini
# Windows download markers copied into WSL
*:Zone.Identifier

# ---- DVC plot renders (regenerate with `dvc plots show`) ----
dvc_plots/

# ---- Hand-off bundles and stray copies --------------------------------------
# The daily update zips are unpacked over the repo; the zips themselves and any
# merge/editor leftovers never belong in Git.
*.zip
*.orig
*.rej
*.bak
*.tmp
nohup.out
/tmp/

# ---- Personal prep notes and local tooling (kept on the laptop, not in Git) ----
docs/DEMO_SCRIPT.md
docs/VIVA_PREP.md
docs/COMPLIANCE.md
.pre-commit-config.yaml
docs/RUNBOOK.md
/images/
