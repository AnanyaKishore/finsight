{
  "components": {
    "schemas": {
      "Allocation": {
        "description": "Weights and annualised statistics of one portfolio.",
        "properties": {
          "expected_return": {
            "title": "Expected Return",
            "type": "number"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "sharpe": {
            "title": "Sharpe",
            "type": "number"
          },
          "volatility": {
            "title": "Volatility",
            "type": "number"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Weights",
            "type": "object"
          }
        },
        "required": [
          "method",
          "weights",
          "expected_return",
          "volatility",
          "sharpe"
        ],
        "title": "Allocation",
        "type": "object"
      },
      "AnalyzeRequest": {
        "description": "``POST /api/sentiment/analyze`` body.",
        "properties": {
          "texts": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Texts",
            "type": "array"
          }
        },
        "required": [
          "texts"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "AnalyzeResponse": {
        "description": "``POST /api/sentiment/analyze`` response.",
        "properties": {
          "model": {
            "$ref": "#/components/schemas/ModelRef"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/AnalyzeResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results",
          "model"
        ],
        "title": "AnalyzeResponse",
        "type": "object"
      },
      "AnalyzeResult": {
        "description": "Model output for one text.",
        "properties": {
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "label": {
            "enum": [
              "positive",
              "negative",
              "neutral"
            ],
            "title": "Label",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "label",
          "confidence",
          "score"
        ],
        "title": "AnalyzeResult",
        "type": "object"
      },
      "DependencyStatus": {
        "description": "Health of one dependency.",
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Uniform error payload.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Envelope for every 4xx / 5xx response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ForecastPoint": {
        "description": "Price on one date (history or forecast).",
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "number"
          }
        },
        "required": [
          "date",
          "price"
        ],
        "title": "ForecastPoint",
        "type": "object"
      },
      "Headline": {
        "description": "An explanatory headline for a weekly bar.",
        "properties": {
          "headline": {
            "title": "Headline",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "headline",
          "score"
        ],
        "title": "Headline",
        "type": "object"
      },
      "HealthResponse": {
        "description": "``GET /api/health``: ``ok`` if everything is up, ``degraded`` otherwise.",
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelInfo": {
        "description": "Production model as recorded in the MLflow registry.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Tags",
            "type": "object"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "ModelInfoResponse": {
        "description": "``GET /api/model-info``.",
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "title": "Models",
            "type": "array"
          },
          "registry_reachable": {
            "title": "Registry Reachable",
            "type": "boolean"
          }
        },
        "required": [
          "models",
          "registry_reachable"
        ],
        "title": "ModelInfoResponse",
        "type": "object"
      },
      "ModelRef": {
        "description": "Which registered model produced a result.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ModelRef",
        "type": "object"
      },
      "Overview": {
        "description": "Latest price with the day's change (green/red indicator in the UI).",
        "properties": {
          "change": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change"
          },
          "change_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Pct"
          },
          "close": {
            "title": "Close",
            "type": "number"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "direction": {
            "enum": [
              "up",
              "down",
              "flat"
            ],
            "title": "Direction",
            "type": "string"
          },
          "previous_close": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Close"
          }
        },
        "required": [
          "date",
          "close",
          "previous_close",
          "change",
          "change_pct",
          "direction"
        ],
        "title": "Overview",
        "type": "object"
      },
      "PortfolioResponse": {
        "description": "``GET /api/portfolio``.",
        "properties": {
          "allocation": {
            "$ref": "#/components/schemas/Allocation"
          },
          "as_of": {
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "beats_equal_weight_out_of_sample": {
            "title": "Beats Equal Weight Out Of Sample",
            "type": "boolean"
          },
          "disclaimer": {
            "default": "For information and education only. Not investment advice; past performance and model forecasts do not guarantee future results.",
            "title": "Disclaimer",
            "type": "string"
          },
          "equal_weight": {
            "$ref": "#/components/schemas/Allocation"
          },
          "fallback_used": {
            "title": "Fallback Used",
            "type": "boolean"
          },
          "grid_size": {
            "title": "Grid Size",
            "type": "integer"
          },
          "min_volatility": {
            "$ref": "#/components/schemas/Allocation"
          },
          "out_of_sample": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            "description": "walk-forward performance per strategy (annualised)",
            "title": "Out Of Sample",
            "type": "object"
          },
          "risk_free_rate": {
            "title": "Risk Free Rate",
            "type": "number"
          },
          "window_days": {
            "title": "Window Days",
            "type": "integer"
          },
          "window_end": {
            "format": "date",
            "title": "Window End",
            "type": "string"
          },
          "window_start": {
            "format": "date",
            "title": "Window Start",
            "type": "string"
          }
        },
        "required": [
          "as_of",
          "window_start",
          "window_end",
          "window_days",
          "risk_free_rate",
          "grid_size",
          "fallback_used",
          "allocation",
          "equal_weight",
          "min_volatility",
          "out_of_sample",
          "beats_equal_weight_out_of_sample"
        ],
        "title": "PortfolioResponse",
        "type": "object"
      },
      "PredictionResponse": {
        "description": "``GET /api/prediction/{ticker}``: history + dashed 14-day forecast.",
        "properties": {
          "as_of": {
            "description": "last observed trading day (forecast origin)",
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "disclaimer": {
            "default": "For information and education only. Not investment advice; past performance and model forecasts do not guarantee future results.",
            "title": "Disclaimer",
            "type": "string"
          },
          "forecast": {
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "title": "Forecast",
            "type": "array"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "title": "History",
            "type": "array"
          },
          "horizon": {
            "title": "Horizon",
            "type": "integer"
          },
          "model": {
            "$ref": "#/components/schemas/ModelRef"
          },
          "stale": {
            "description": "true if served from an earlier forecast (model down)",
            "title": "Stale",
            "type": "boolean"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "as_of",
          "horizon",
          "history",
          "forecast",
          "model",
          "stale",
          "generated_at"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "PricePoint": {
        "description": "One end-of-day bar.",
        "properties": {
          "close": {
            "title": "Close",
            "type": "number"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "high": {
            "title": "High",
            "type": "number"
          },
          "low": {
            "title": "Low",
            "type": "number"
          },
          "open": {
            "title": "Open",
            "type": "number"
          },
          "volume": {
            "title": "Volume",
            "type": "number"
          }
        },
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "PricePoint",
        "type": "object"
      },
      "SearchHit": {
        "description": "One type-ahead suggestion.",
        "properties": {
          "matched": {
            "description": "what matched: symbol, name or alias",
            "title": "Matched",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sector": {
            "title": "Sector",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "name",
          "sector",
          "matched"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "SearchResponse": {
        "description": "``GET /api/search``.",
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "query",
          "results"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SentimentResponse": {
        "description": "``GET /api/sentiment/{ticker}``.",
        "properties": {
          "disclaimer": {
            "default": "For information and education only. Not investment advice; past performance and model forecasts do not guarantee future results.",
            "title": "Disclaimer",
            "type": "string"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "overall_mean_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overall Mean Score"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "total_articles": {
            "title": "Total Articles",
            "type": "integer"
          },
          "weeks": {
            "items": {
              "$ref": "#/components/schemas/SentimentWeek"
            },
            "title": "Weeks",
            "type": "array"
          }
        },
        "required": [
          "symbol",
          "weeks",
          "overall_mean_score",
          "total_articles",
          "model_version"
        ],
        "title": "SentimentResponse",
        "type": "object"
      },
      "SentimentWeek": {
        "description": "One bar of the weekly sentiment chart.",
        "properties": {
          "article_count": {
            "title": "Article Count",
            "type": "integer"
          },
          "mean_score": {
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Mean Score",
            "type": "number"
          },
          "negative": {
            "title": "Negative",
            "type": "integer"
          },
          "neutral": {
            "title": "Neutral",
            "type": "integer"
          },
          "positive": {
            "title": "Positive",
            "type": "integer"
          },
          "top_negative": {
            "items": {
              "$ref": "#/components/schemas/Headline"
            },
            "title": "Top Negative",
            "type": "array"
          },
          "top_positive": {
            "items": {
              "$ref": "#/components/schemas/Headline"
            },
            "title": "Top Positive",
            "type": "array"
          },
          "week_start": {
            "format": "date",
            "title": "Week Start",
            "type": "string"
          }
        },
        "required": [
          "week_start",
          "mean_score",
          "article_count",
          "positive",
          "negative",
          "neutral",
          "top_positive",
          "top_negative"
        ],
        "title": "SentimentWeek",
        "type": "object"
      },
      "StockResponse": {
        "description": "``GET /api/stock/{ticker}``.",
        "properties": {
          "history": {
            "items": {
              "$ref": "#/components/schemas/PricePoint"
            },
            "title": "History",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "overview": {
            "$ref": "#/components/schemas/Overview"
          },
          "period": {
            "enum": [
              "1W",
              "1M",
              "3M",
              "6M",
              "1Y",
              "ALL"
            ],
            "title": "Period",
            "type": "string"
          },
          "sector": {
            "title": "Sector",
            "type": "string"
          },
          "source": {
            "description": "price provider of the latest bar",
            "title": "Source",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "name",
          "sector",
          "period",
          "overview",
          "history",
          "source"
        ],
        "title": "StockResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Stock analytics: forecasts, news sentiment, portfolio. Not investment advice.",
    "title": "FinSight API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Status of MongoDB, both model servers and the registry.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/model-info": {
      "get": {
