# Git LFS: binary documentation assets (diagrams, screenshots, PDFs, slides).
# Data and model artifacts are versioned with DVC, NOT LFS -- LFS is for the
# binary files that must live next to the code in Git itself.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
# A tiny bootstrap model kept in Git for graceful degradation (Day 5).
*.pt   filter=lfs diff=lfs merge=lfs -text

# Normalise line endings so the Linux containers never see CRLF in scripts.
*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
