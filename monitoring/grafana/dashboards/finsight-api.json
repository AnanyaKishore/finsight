{
  "uid": "finsight-api",
  "title": "FinSight \u00b7 API & model serving",
  "description": "FastAPI backend and the two MLflow model servers (via the backend).",
  "tags": [
    "finsight",
    "api"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Pipeline Console",
      "type": "link",
      "url": "http://localhost:8080/#/pipeline",
      "targetBlank": true
    },
    {
      "title": "Prometheus alerts",
      "type": "link",
      "url": "http://localhost:9090/alerts",
      "targetBlank": true
    },
    {
      "title": "Alertmanager",
      "type": "link",
      "url": "http://localhost:9093",
      "targetBlank": true
    },
    {
      "title": "MLflow",
      "type": "link",
      "url": "http://localhost:5000",
      "targetBlank": true
    },
    {
      "title": "FinSight dashboards",
      "type": "dashboards",
      "tags": [
        "finsight"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Traffic and errors",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(finsight_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#1baf7a"
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
