{
  "uid": "finsight-pipeline",
  "title": "FinSight \u00b7 Pipeline & data",
  "description": "Daily and retrain runs from the scheduler; data freshness and quality.",
  "tags": [
    "finsight",
    "pipeline"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Pipeline Console",
      "type": "link",
      "url": "http://localhost:8080/#/pipeline",
      "targetBlank": true
    },
    {
      "title": "Prometheus alerts",
      "type": "link",
      "url": "http://localhost:9090/alerts",
      "targetBlank": true
    },
    {
      "title": "Alertmanager",
      "type": "link",
      "url": "http://localhost:9093",
      "targetBlank": true
    },
    {
      "title": "MLflow",
      "type": "link",
      "url": "http://localhost:5000",
      "targetBlank": true
    },
    {
      "title": "FinSight dashboards",
