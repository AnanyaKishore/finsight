# --------------------------------------------------------------------------- #
# Copy to .env and fill in.  .env is git-ignored and must NEVER be committed.
#   cp .env.example .env
# (Day 9 adds an encrypted copy, secrets/.env.enc, that IS safe to commit.)
# --------------------------------------------------------------------------- #

# ---- External data APIs ------------------------------------------------------
# https://marketstack.com/signup/free  (100 requests/month, 12 months history)
MARKETSTACK_API_KEY=replace-me
MARKETSTACK_BASE_URL=https://api.marketstack.com/v2
# https://finnhub.io/register  (free: 60 calls/minute, ~1 year company news)
FINNHUB_API_KEY=replace-me
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ---- MongoDB (self-hosted, docker compose service "mongo") ------------------
MONGO_ROOT_USER=finsight
# generate with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_ROOT_PASSWORD=replace-me
MONGO_DB_NAME=finsight
# Host-side processes (your laptop) reach mongo on localhost; containers use
# the service name "mongo". docker-compose.yml overrides MONGO_HOST for containers.
MONGO_HOST=localhost
MONGO_PORT=27017

# ---- MLflow (docker compose service "mlflow") -------------------------------
# Training on the host talks to the server through the published port.
MLFLOW_TRACKING_URI=http://localhost:5000
# Silence MLflow's start-up hint messages in our logs.
MLFLOW_DISABLE_AGENT_HINT=1

# ---- Web portal (Day 6) -----------------------------------------------------
# Where the *browser* reaches the API, and which portal addresses the API
# accepts (CORS). Defaults work for http://localhost:8080 on this machine.
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
TZ=Asia/Kolkata
