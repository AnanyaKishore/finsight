# FinSight portal: nginx serving static files (no server-side code).
#
# This is a *template*: the nginx image's entrypoint runs envsubst on it at
# container start-up and writes /etc/nginx/conf.d/default.conf. Only variables
# that are set in the environment are replaced (BACKEND_URL, MLFLOW_UI_URL,
# PROMETHEUS_UI_URL, GRAFANA_UI_URL, ALERTMANAGER_UI_URL), so
# nginx's own variables such as $uri are left alone.
#
# Loose coupling: the browser calls the backend directly at BACKEND_URL. The
# same image works against any backend; only the environment changes.

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Security headers. connect-src allows the API origin and nothing else.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${BACKEND_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    # Runtime configuration for the browser, generated from the environment.
    # Never cached, so changing BACKEND_URL needs only a container restart.
    location = /config.js {
        default_type application/javascript;
        expires -1;
        return 200 'window.FINSIGHT_CONFIG = { backendUrl: "${BACKEND_URL}", mlflowUrl: "${MLFLOW_UI_URL}", prometheusUrl: "${PROMETHEUS_UI_URL}", grafanaUrl: "${GRAFANA_UI_URL}", alertmanagerUrl: "${ALERTMANAGER_UI_URL}" };\n';
    }

    # Liveness probe for the compose healthcheck.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Files are not fingerprinted, so ask browsers to revalidate every time
    # (cheap: nginx answers 304 Not Modified when nothing changed).
    location / {
        expires -1;
        try_files $uri $uri/ =404;
    }
}

# Day 8: connection / request counters for Prometheus (nginx-exporter).
# Port 8081 is not published by compose: only containers on the finsight
# network (the exporter) can reach it.
server {
    listen 8081;
    server_name _;
    access_log off;
    location = /stub_status {
        stub_status;
    }
    location / {
        return 404;
    }
}
